@page "/packages/{id}/{version?}"
@using BaGetter.Core.Configuration
@using System.Globalization
@using Humanizer
@using Microsoft.AspNetCore.Html
@using Microsoft.Extensions.Options
@model PackageModel
@inject IOptions<NugetAuthenticationOptions> AuthOptions

@{
    ViewData["Title"] = Model.Found
        ? Model.Package.Id + " " + Model.Package.NormalizedVersionString
        : Model.Package?.Id;
    var requiresAuth = AuthOptions.Value.Mode != AuthenticationMode.Config;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var fallbackIconUrl = Url.Content("~/_content/BaGetter.Web/images/default-package-icon-256x256.png");
    var atomFeedUrl = Model.Found ? Url.RouteUrl(Routes.PackageAtomFeedRouteName, new { id = Model.Package.Id }) : null;
}

@section Head {
    @if (atomFeedUrl != null)
    {
        <link rel="alternate" type="application/atom+xml" title="@Model.Package.Id versions" href="@atomFeedUrl" />
    }
}

@if (requiresAuth && !isAuthenticated)
{
    // Generic on purpose: anonymous visitors must not learn feed or package names.
    ViewData["Title"] = "Sign in required";
    <div class="text-center" style="margin-top: 60px;">
        <h2>Sign in required</h2>
        <p>You need to sign in to view package details.</p>
        <a asp-page="/Login" class="btn btn-primary">Sign in</a>
    </div>
    return;
}

@if (Model.VersionNotFound != null)
{
    <div>
        <h2>Version not found</h2>
        <p>Package '@Model.Package.Id' has no version '@Model.VersionNotFound' in this feed.</p>
        <p><a asp-page="Package" asp-route-id="@Model.Package.Id" asp-route-version="">Show the latest version</a></p>
    </div>
}
else if (!Model.Found)
{
    <div>
        <h2>Oops, package not found...</h2>
        <p>Could not find package '@Model.Package.Id'.</p>
        <p>You can try searching on <a href="https://www.nuget.org/packages?q=@Uri.EscapeDataString(Model.Package.Id)" target="_blank" rel="noopener noreferrer">nuget.org</a> package.</p>
        <p>Think there's a problem? Consider taking a look at our <a href="https://letreset.github.io/BaGetter/docs" target="_blank" rel="noopener noreferrer">documentation</a> or asking for help on our <a href="https://github.com/letreset/BaGetter/issues" target="_blank" rel="noopener noreferrer">GitHub project</a></p>
    </div>
}
else
{
    <div class="row display-package">
        <aside class="col-sm-1 package-icon">
            <img src="@(string.IsNullOrEmpty(Model.IconUrl) ? fallbackIconUrl : Model.IconUrl)"
                 class="img-responsive"
                 onerror="this.src='@fallbackIconUrl'"
                 alt="The package icon" />
        </aside>

        <article class="col-sm-8 package-details-main">
            <div class="package-title">
                <h1>
                    @Model.Package.Id

                    <small class="text-nowrap">@Model.Package.NormalizedVersionString</small>
                </h1>

                @if (!string.IsNullOrWhiteSpace(Model.Package.Title)
                    && !Model.Package.Title.Equals(Model.Package.Id, StringComparison.OrdinalIgnoreCase))
                {
                    <p class="package-title-text">@Model.Package.Title</p>
                }
            </div>

            @if (Model.FrameworkBadges.Any())
            {
                <div class="framework-badges">
                    @foreach (var framework in Model.FrameworkBadges)
                    {
                        <span class="framework-badge" title="This package targets @framework. The package is compatible with this framework or higher.">@framework</span>
                    }
                </div>
            }

            <div class="tabbed-info" x-data="{ tabs: tabs, active: tabs[0] }">
                <ul class="nav">
                    <template x-for="tab in tabs" :key="tab.name">
                        <li x-bind:class="{ active: tab.name === active.name }">
                            <a href="#" x-text="tab.name" @@click="active = tab"></a>
                        </li>
                    </template>
                </ul>

                <div class="content">
                    <div class="script">
                        <template x-for="line in active.content">
                            <div x-text="active.prefix ? `${active.prefix} ${line}` : line"></div>
                        </template>
                    </div>

                    <div class="copy-button">
                        <button class="btn btn-default btn-warning"
                                type="button"
                                data-tottle="popover"
                                data-placement="bottom"
                                data-content="Copied"
                                @@click="window.baget.copyTextToClipboard(active.content.join('\n'), $el)">
                            <i class="ms-Icon ms-Icon--Copy"></i>
                        </button>
                    </div>
                </div>
            </div>

            @if (Model.Package.IsPrerelease || !string.IsNullOrEmpty(Model.Package.MinClientVersion) || Model.Package.RequireLicenseAcceptance)
            {
                <ul class="list-unstyled package-notes">
                    @if (Model.Package.IsPrerelease)
                    {
                        <li><i class="ms-Icon ms-Icon--Info" aria-hidden="true"></i> This is a prerelease version of @Model.Package.Id.</li>
                    }
                    @if (!string.IsNullOrEmpty(Model.Package.MinClientVersion))
                    {
                        <li><i class="ms-Icon ms-Icon--Info" aria-hidden="true"></i> Requires NuGet @Model.Package.MinClientVersion or higher.</li>
                    }
                    @if (Model.Package.RequireLicenseAcceptance)
                    {
                        <li><i class="ms-Icon ms-Icon--Info" aria-hidden="true"></i> This package requires license acceptance.</li>
                    }
                </ul>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Package.Summary))
            {
                <p class="package-summary">@Model.Package.Summary</p>
            }

            @{
                ExpandableSection("Readme", "ms-Icon--Dictionary", expanded: false,
                    @<div>
                        @if (Model.Readme == null)
                        {
                            <div class="package-description">@Model.Package.Description</div>
                        }
                        else
                        {
                            <div class="package-readme">@Model.Readme</div>
                        }
                    </div>);
            }

            @if (!Model.IsDotnetTemplate && !Model.IsDotnetTool)
            {
                ExpandableSection("Used By", "ms-Icon--BranchFork2", expanded: false,
                    @<div class="package-used-by">
                        @if (!Model.UsedBy.Any())
                        {
                            <p>No packages depend on @Model.Package.Id.</p>
                        }
                        else
                        {
                            <p>Showing the top 20 packages that depend on @Model.Package.Id.</p>
                            <div>
                                <table>
                                    <thead>
                                        <tr>
                                            <th class="col-sm-10">Packages</th>
                                            <th class="col-sm-2">Downloads</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var package in Model.UsedBy)
                                        {
                                            <tr>
                                                <td>
                                                    <a href="@Url.Page("/Package", new { package.Id })">@package.Id</a>
                                                    <div>@package.Description</div>
                                                </td>
                                                <td>
                                                    <i class="ms-Icon ms-Icon--Download" aria-hidden="true"></i>
                                                    <span>@package.TotalDownloads.ToString("N0", CultureInfo.InvariantCulture)</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>);
            }

            @if (!string.IsNullOrEmpty(Model.Package.ReleaseNotes))
            {
                ExpandableSection("Release Notes", "ms-Icon--ReadingMode", expanded: false,
                    @<div class="package-release-notes">@Model.ParsedReleaseNotes</div>);
            }

            @{ ExpandableSection("Dependencies", "ms-Icon--Packages", expanded: false,
                @<div class="dependency-groups">
                    @if (!Model.DependencyGroups.Any())
                    {
                        @:This package has no dependencies.
                    }
                    else
                    {
                        foreach (var group in Model.DependencyGroups)
                        {
                            <h4>
                                <span>@group.Name</span>
                            </h4>

                            <ul class="list-unstyled dependency-group">
                                @if (!group.Dependencies.Any())
                                {
                                    <li>No dependencies.</li>
                                }
                                else
                                {
                                    @foreach (var dependency in group.Dependencies)
                                    {
                                        <li>
                                            <a asp-page="Package"
                                               asp-route-id="@dependency.PackageId"
                                               asp-route-version="@null">
                                                @dependency.PackageId
                                            </a>

                                            <span> @dependency.VersionSpec</span>
                                        </li>
                                    }
                                }
                            </ul>
                        }
                    }
                </div>);
            }

            @if (Model.Frameworks.Any())
            {
                ExpandableSection("Frameworks", "ms-Icon--Library", expanded: false,
                    @<ul class="list-unstyled package-frameworks">
                        @foreach (var framework in Model.Frameworks)
                        {
                            <li>@framework</li>
                        }
                    </ul>);
            }

            @{ ExpandableSection("Versions", "ms-Icon--Stopwatch", expanded: true,
                @<div class="version-list" x-data="{ showAll: false, includePrerelease: true }">
                    @if (Model.HasPrereleaseVersions)
                    {
                        <label class="checkbox-inline version-prerelease-filter">
                            <input type="checkbox" x-model="includePrerelease" /> Include prerelease
                        </label>
                    }
                    <table class="table borderless">
                        <thead>
                            <tr>
                                <th>Version</th>
                                <th>Downloads</th>
                                <th>Last updated</th>
                            </tr>
                        </thead>
                        <tbody class="no-border">
                            @for (var i = 0; i < Model.Versions.Count; i++)
                            {
                                var version = Model.Versions[i];
                                var alwaysShow = Json.Serialize(i < DefaultVisibleVersions);
                                var isPrerelease = Json.Serialize(version.IsPrerelease);

                                <tr class="@(version.Selected ? "bg-info" : "")" x-show="(includePrerelease || !@isPrerelease) && (showAll || !includePrerelease || @alwaysShow)">
                                    <td>
                                        <a asp-page="Package" asp-route-version="@version.Version"
                                           style="@(version.Listed ? null : "text-decoration: line-through;")">@version.Version.ToNormalizedString()</a>
                                        @if (!version.Listed)
                                        {
                                            <span class="text-muted" style="margin-left:6px;">(unlisted)</span>
                                            @if (Model.CanManage && version.IsLocal)
                                            {
                                                <form method="post" asp-page-handler="Relist"
                                                      asp-route-id="@Model.Package.Id"
                                                      asp-route-version="@version.Version.ToNormalizedString()"
                                                      style="display:inline; margin-left:6px;">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="link-button" title="Relist this version">Relist</button>
                                                </form>
                                            }
                                        }
                                        @if (!version.IsLocal)
                                        {
                                            <span class="label label-default" style="margin-left:6px;" title="Available from a mirror, not stored in this feed yet">mirror</span>
                                        }
                                    </td>
                                    <td>@(version.IsLocal ? version.Downloads.ToString("N0", CultureInfo.InvariantCulture) : "")</td>
                                    <td>@if (version.LastUpdated.HasValue) { @Html.DisplayDate(version.LastUpdated.Value) }</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    @if (Model.Versions.Count > DefaultVisibleVersions)
                    {
                        @* Hiding prereleases lifts the row cap, so the toggle is only needed with them shown. *@
                        <button type="button" class="link-button" x-show="includePrerelease" @@click="showAll = !showAll">
                            <i class="ms-Icon" x-bind:class="{ 'ms-Icon--CalculatorAddition': !showAll, 'ms-Icon--CalculatorSubtract': showAll }"></i>
                            <span x-text="showAll ? 'Show less' : 'Show more'"></span>
                        </button>
                    }

                </div>);
            }
        </article>

        <aside class="col-sm-3 package-details-info">
            <div>
                <h2>Info</h2>

                <ul class="list-unstyled ms-Icon-ul">
                    <li>
                        <i class="ms-Icon ms-Icon--History" aria-hidden="true"></i>
                        Last updated @Html.DisplayDate(Model.LastUpdated, Model.LastUpdated.Humanize(culture: CultureInfo.InvariantCulture))
                    </li>

                    @if (!string.IsNullOrEmpty(Model.Package.ProjectUrlString))
                    {
                        <li>
                            <i class="ms-Icon ms-Icon--Globe"></i>
                            <a href="@Model.Package.ProjectUrlString">Project URL</a>
                        </li>
                    }

                    @if (!string.IsNullOrEmpty(Model.Package.RepositoryUrlString))
                    {
                        <li>
                            <span class="icon github-icon" aria-hidden="true"></span>
                            <a href="@Model.Package.RepositoryUrlString">Source code</a>
                        </li>
                    }

                    @if (!string.IsNullOrEmpty(Model.LicenseUrl))
                    {
                        <li>
                            <i class="ms-Icon ms-Icon--Certificate"></i>
                            <a href="@Model.LicenseUrl">@Model.LicenseText</a>
                        </li>
                    }

                    <li>
                        <i class="ms-Icon ms-Icon--CloudDownload"></i>
                        <a href="@Model.PackageDownloadUrl">Download package</a>
                        @if (Model.PackageSize != null)
                        {
                            <span class="text-muted">(@Model.PackageSize)</span>
                        }
                    </li>

                    <li>
                        <i class="ms-Icon ms-Icon--News"></i>
                        <a href="@atomFeedUrl" title="Subscribe to new versions. Feed readers sign in with a personal access token.">Atom feed</a>
                    </li>
                </ul>
            </div>

            <div>
                <h2>Statistics</h2>

                <ul class="list-unstyled ms-Icon-ul">
                    <li>
                        <i class="ms-Icon ms-Icon--Download"></i>
                        @Model.TotalDownloads.ToString("N0", CultureInfo.InvariantCulture) total downloads
                    </li>

                    <li>
                        <i class="ms-Icon ms-Icon--Giftbox"></i>
                        @Model.Package.Downloads.ToString("N0", CultureInfo.InvariantCulture) downloads of current version
                    </li>

                    @if (Model.DailyDownloadAverage.HasValue)
                    {
                        <li>
                            <i class="ms-Icon ms-Icon--Calendar"></i>
                            @Model.DailyDownloadAverage.Value.ToString("N0", CultureInfo.InvariantCulture) per day average
                        </li>
                    }
                </ul>
            </div>

            @if (Model.Package.Authors.Any())
            {
                <div>
                    <h2>Authors</h2>

                    <p>@string.Join(", ", Model.Package.Authors)</p>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Package.Copyright))
            {
                <div>
                    <h2>Copyright</h2>

                    <p class="package-copyright">@Model.Package.Copyright</p>
                </div>
            }

            @if (Model.Package.Tags.Any())
            {
                <div>
                    <h2>Tags</h2>

                    <p>
                        @foreach(var tag in Model.Package.Tags)
                        {
                            <span class="tag">@tag</span>
                        }
                    </p>
                </div>
            }

            @if (Model.CanManage && Model.IsStoredLocally)
            {
                <div>
                    <h2>Manage</h2>

                    <p class="text-muted">
                        Unlist hides this version from search and listings but keeps the file.
                        Delete permanently removes the package and its files.
                    </p>

                    <form method="post" asp-page-handler="Unlist"
                          asp-route-id="@Model.Package.Id"
                          asp-route-version="@Model.Package.NormalizedVersionString"
                          style="display:inline"
                          data-confirm="@($"Unlist {Model.Package.Id} {Model.Package.NormalizedVersionString}? It will be hidden from search and listings. You can relist it later.")">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-default">
                            <i class="ms-Icon ms-Icon--Hide" aria-hidden="true"></i>
                            Unlist
                        </button>
                    </form>

                    <form method="post" asp-page-handler="Delete"
                          asp-route-id="@Model.Package.Id"
                          asp-route-version="@Model.Package.NormalizedVersionString"
                          style="display:inline"
                          data-confirm="@($"Permanently delete {Model.Package.Id} {Model.Package.NormalizedVersionString}? This removes the package and its files and cannot be undone.")">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">
                            <i class="ms-Icon ms-Icon--Delete" aria-hidden="true"></i>
                            Delete
                        </button>
                    </form>
                </div>
            }
        </aside>
    </div>
}

@if (Model.Found)
{
    <script type="text/javascript">
        let tabs = [
            @if (Model.IsDotnetTemplate)
            {
                <text>
                {
                    name: ".NET CLI",
                    prefix: ">",
                    content: ["dotnet new --install @Model.Package.Id::@Model.Package.NormalizedVersionString"],
                },
                </text>
            }
            else if (Model.IsDotnetTool)
            {
                <text>
                {
                    name: ".NET CLI (Global)",
                    prefix: ">",
                    content: ["dotnet tool install --global @Model.Package.Id --version @Model.Package.NormalizedVersionString"],
                },
                {
                    name: ".NET CLI (Local)",
                    prefix: ">",
                    content: ["dotnet tool install @Model.Package.Id --version @Model.Package.NormalizedVersionString"],
                },
                </text>
            }
            else
            {
                // A constant, so it is written raw: the encoder would turn '&' into '&amp;' inside the script.
                var cakePrerelease = Model.Package.IsPrerelease ? Html.Raw("&prerelease") : HtmlString.Empty;
                <text>
                {
                    name: ".NET CLI",
                    prefix: ">",
                    content: ["dotnet add package @Model.Package.Id --version @Model.Package.NormalizedVersionString"],
                },
                {
                    name: "Package Manager",
                    prefix: "PM>",
                    content: ["NuGet\\Install-Package @Model.Package.Id -Version @Model.Package.NormalizedVersionString"]
                },
                {
                    name: "PackageReference",
                    prefix: "",
                    content: ["<PackageReference Include=\"@Model.Package.Id\" Version=\"@Model.Package.NormalizedVersionString\" />"]
                },
                {
                    name: "CPM",
                    prefix: "",
                    content: [
                        "<!-- Directory.Packages.props -->",
                        "<PackageVersion Include=\"@Model.Package.Id\" Version=\"@Model.Package.NormalizedVersionString\" />",
                        "<!-- Project file -->",
                        "<PackageReference Include=\"@Model.Package.Id\" />"
                    ]
                },
                {
                    name: "Paket CLI",
                    prefix: ">",
                    content: ["paket add @Model.Package.Id --version @Model.Package.NormalizedVersionString"]
                },
                {
                    name: "Script & Interactive",
                    prefix: "",
                    content: ["#r \"nuget: @Model.Package.Id, @Model.Package.NormalizedVersionString\""]
                },
                {
                    name: "File-based Apps",
                    prefix: "",
                    content: ["#:package @(Model.Package.Id)@@@(Model.Package.NormalizedVersionString)"]
                },
                {
                    name: "Cake",
                    prefix: "",
                    content: [
                        "// Install @Model.Package.Id as a Cake Addin",
                        "#addin nuget:?package=@Model.Package.Id&version=@(Model.Package.NormalizedVersionString)@(cakePrerelease)",
                        "// Install @Model.Package.Id as a Cake Tool",
                        "#tool nuget:?package=@Model.Package.Id&version=@(Model.Package.NormalizedVersionString)@(cakePrerelease)"
                    ]
                },
                </text>
            }
        ];
    </script>
}

@functions {

    private const int DefaultVisibleVersions = 5;

    private void ExpandableSection(string title, string icon, bool expanded, Func<object, IHtmlContent> template)
    {
        <div class="expandable-section" x-data="{ expanded: @Json.Serialize(expanded) }">
            <h2>
                <button type="button" class="link-button" @@click="expanded = !expanded">
                    <i x-bind:class="{ 'ms-Icon--ChevronDown': expanded, 'ms-Icon--ChevronRight': !expanded }"
                    class="ms-Icon">
                    </i>
                    <span>
                        @if (!string.IsNullOrWhiteSpace(icon))
                        {
                            <i class="ms-Icon @icon" aria-hidden="true"></i>
                        }
                        @title
                    </span>
                </button>
            </h2>

        <div x-show="expanded">@template(null)</div>
        </div>
    }
}
