@page "/stats"

@model StatisticsModel

@using System.Globalization
@using BaGetter.Core.Configuration
@using BaGetter.Core.Statistics
@using BaGetter.Web.Extensions
@using BaGetter.Web.Helper
@using Microsoft.Extensions.Options

@inject IOptionsSnapshot<StatisticsOptions> Options
@inject IOptionsSnapshot<NugetAuthenticationOptions> AuthOptions
@inject IStatisticsService StatisticsService
@inject ApplicationVersion Version

@{
    ViewData["Title"] = "Stats — " + Model.FeedName;
    var requiresAuth = AuthOptions.Value.Mode != AuthenticationMode.Config;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}

@if (requiresAuth && !isAuthenticated)
{
    // Generic on purpose: anonymous visitors must not learn feed or package names.
    ViewData["Title"] = "Sign in required";
    <div class="text-center" style="margin-top: 60px;">
        <h2>Sign in required</h2>
        <p>You need to sign in to view statistics.</p>
        <a asp-page="/Login" class="btn btn-primary">Sign in</a>
    </div>
    return;
}

@{
    var stats = Model.FeedStatistics;
}

<div class="col-sm-12">
    <h1>Statistics &mdash; @Model.FeedName</h1>
    <hr class="breadcrumb-divider" />
    <div class="row">
        <article class="col-sm-4">
            <h4>Current version</h4>
        </article>
        <div class="col-sm-8">
            <h4>@Version.InformationalVersion</h4>
        </div>
    </div>
    <div class="row">
        <article class="col-sm-4">
            <h4>Total amount of packages</h4>
        </article>
        <div class="col-sm-8">
            <h4>@Model.PackagesTotal</h4>
        </div>
    </div>
    <div class="row">
        <article class="col-sm-4">
            <h4>Total amount of package versions</h4>
        </article>
        <div class="col-sm-8">
            <h4>@Model.VersionsTotal</h4>
        </div>
    </div>
    <div class="row">
        <article class="col-sm-4">
            <h4>Versions by state</h4>
        </article>
        <div class="col-sm-8">
            <h4>@stats.StableVersions stable, @stats.PrereleaseVersions prerelease (@stats.UnlistedVersions unlisted)</h4>
        </div>
    </div>
    <div class="row">
        <article class="col-sm-4">
            <h4>Total downloads</h4>
        </article>
        <div class="col-sm-8">
            <h4>@stats.TotalDownloads.ToString("N0", CultureInfo.InvariantCulture)</h4>
        </div>
    </div>
    <div class="row">
        <article class="col-sm-4">
            <h4>Stored package size</h4>
        </article>
        <div class="col-sm-8">
            <h4>@stats.TotalSizeBytes.ToFileSize()</h4>
        </div>
    </div>
    @if (Options.Value.ListConfiguredServices)
    {
        <div class="row">
            <article class="col-sm-4">
                <h4>Services in use</h4>
            </article>
            <div class="col-sm-8">
                <h4>@string.Join(", ", StatisticsService.GetKnownServices())</h4>
            </div>
        </div>
    }

    <div class="row statistics-lists">
        <section class="col-md-6">
            <h3>Most downloaded</h3>
            @if (stats.MostDownloaded.Count == 0)
            {
                <p class="text-muted">No downloads yet.</p>
            }
            else
            {
                <table class="table table-striped data-table">
                    <thead>
                        <tr>
                            <th>Package</th>
                            <th class="text-right">Downloads</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var package in stats.MostDownloaded)
                        {
                            <tr>
                                <td><a href="@Url.Page("/Package", new { id = package.Id })">@package.Id</a></td>
                                <td class="text-right">@package.Downloads.ToString("N0", CultureInfo.InvariantCulture)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>
        <section class="col-md-6">
            <h3>Recently published</h3>
            @if (stats.RecentlyPublished.Count == 0)
            {
                <p class="text-muted">No packages yet.</p>
            }
            else
            {
                <table class="table table-striped data-table">
                    <thead>
                        <tr>
                            <th>Package</th>
                            <th>Version</th>
                            <th>Published</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var version in stats.RecentlyPublished)
                        {
                            <tr>
                                <td><a href="@Url.Page("/Package", new { id = version.Id, version = version.Version })">@version.Id</a></td>
                                <td class="text-nowrap">@version.Version</td>
                                <td class="text-nowrap">@Html.DisplayDate(version.Published)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>
    </div>
</div>
