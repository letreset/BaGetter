@page "/Admin/Feeds/{slug}/Settings"
@model BaGetter.Web.Pages.Admin.FeedSettingsModel
@using BaGetter.Core.Configuration
@using BaGetter.Web.Pages.Admin

@{
    // Renders one mirror of the list. The index is a number for stored mirrors and "__index__" in
    // the template for new ones; the script renumbers rows so posted indexes follow display order.
    void MirrorRow(string index, FeedSettingsModel.MirrorInput mirror)
    {
        var prefix = $"Mirrors[{index}]";
        var idPrefix = $"Mirrors_{index}__";
        <div class="panel panel-default mirror-row">
            <div class="panel-heading clearfix">
                <strong class="mirror-title">Mirror</strong>
                <span class="pull-right">
                    <button type="button" class="btn btn-default btn-xs mirror-up" title="Move up" aria-label="Move up">&uarr;</button>
                    <button type="button" class="btn btn-default btn-xs mirror-down" title="Move down" aria-label="Move down">&darr;</button>
                    <button type="button" class="btn btn-danger btn-xs mirror-remove">Remove</button>
                </span>
            </div>
            <div class="panel-body">
                <input type="hidden" name="@(prefix).Id" value="@mirror.Id" />
                <div class="form-group">
                    <div class="checkbox">
                        <label>
                            <input type="checkbox" name="@(prefix).Enabled" value="true" checked="@mirror.Enabled" />
                            Enabled
                        </label>
                    </div>
                </div>
                <div class="form-group">
                    <label for="@(idPrefix)PackageSource">Package source URL</label>
                    <input id="@(idPrefix)PackageSource" name="@(prefix).PackageSource" value="@mirror.PackageSource" type="url" class="form-control" placeholder="https://api.nuget.org/v3/index.json" required />
                </div>
                <div class="form-group">
                    <div class="checkbox">
                        <label>
                            <input type="checkbox" name="@(prefix).Legacy" value="true" checked="@mirror.Legacy" />
                            Use NuGet V2 (legacy) protocol
                        </label>
                    </div>
                </div>
                <div class="form-group">
                    <label for="@(idPrefix)DownloadTimeoutSeconds">Download timeout (seconds)</label>
                    <input id="@(idPrefix)DownloadTimeoutSeconds" name="@(prefix).DownloadTimeoutSeconds" value="@mirror.DownloadTimeoutSeconds" type="number" min="1" class="form-control" style="max-width:160px" />
                    @Html.ValidationMessage(prefix + ".DownloadTimeoutSeconds", new { @class = "text-danger" })
                </div>
                <div class="form-group">
                    <label for="@(idPrefix)AuthType">Authentication type</label>
                    <select id="@(idPrefix)AuthType" name="@(prefix).AuthType" class="form-control" style="max-width:240px">
                        <!option value="">None</!option>
                        <!option value="@MirrorAuthenticationType.Basic" selected="@(mirror.AuthType == MirrorAuthenticationType.Basic)">Basic</!option>
                        <!option value="@MirrorAuthenticationType.Bearer" selected="@(mirror.AuthType == MirrorAuthenticationType.Bearer)">Bearer token</!option>
                        <!option value="@MirrorAuthenticationType.Custom" selected="@(mirror.AuthType == MirrorAuthenticationType.Custom)">Custom headers</!option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="@(idPrefix)AuthUsername">Username (Basic auth)</label>
                    <input id="@(idPrefix)AuthUsername" name="@(prefix).AuthUsername" value="@mirror.AuthUsername" class="form-control" autocomplete="off" />
                </div>
                <div class="form-group">
                    <label for="@(idPrefix)AuthPasswordNew">Password (leave blank to keep existing)</label>
                    <input id="@(idPrefix)AuthPasswordNew" name="@(prefix).AuthPasswordNew" type="password" class="form-control" autocomplete="new-password" />
                    @if (mirror.HasAuthPassword)
                    {
                        <small class="text-muted">A password is currently set.</small>
                    }
                </div>
                <div class="form-group">
                    <label for="@(idPrefix)AuthTokenNew">Bearer token (leave blank to keep existing)</label>
                    <input id="@(idPrefix)AuthTokenNew" name="@(prefix).AuthTokenNew" type="password" class="form-control" autocomplete="new-password" />
                    @if (mirror.HasAuthToken)
                    {
                        <small class="text-muted">A token is currently set.</small>
                    }
                </div>
                <div class="form-group">
                    <label for="@(idPrefix)AuthCustomHeaders">Custom headers (JSON, e.g. {"X-Header":"value"})</label>
                    <textarea id="@(idPrefix)AuthCustomHeaders" name="@(prefix).AuthCustomHeaders" class="form-control" rows="3" style="font-family:monospace">@mirror.AuthCustomHeaders</textarea>
                </div>
            </div>
        </div>
    }
}

@{
    ViewData["Title"] = "Feed Settings \u2014 " + Model.Feed?.Slug;
}

<div class="col-sm-12">
    <h1>Feed Settings &mdash; <code>@Model.Feed?.Slug</code></h1>
    <p><a asp-page="/Admin/Feeds">&larr; Back to feeds</a></p>
    <hr class="breadcrumb-divider" />

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success" role="alert">@Model.SuccessMessage</div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    <form method="post">
        @Html.AntiForgeryToken()
        <div class="col-sm-8" style="padding-left:0">

            <h3>General</h3>
            <div class="form-group">
                <label asp-for="Name">Display Name</label>
                <input asp-for="Name" class="form-control" required maxlength="256" />
            </div>
            <div class="form-group">
                <label asp-for="Description">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3" maxlength="4000"></textarea>
            </div>
            <div class="form-group">
                <div class="checkbox">
                    <label>
                        <input asp-for="UseGlobalReadOnly" data-controls="IsReadOnlyMode" />
                        Use global default for read-only mode
                    </label>
                </div>
                <div class="checkbox">
                    <label>
                        <input asp-for="IsReadOnlyMode" />
                        Read-only mode (packages cannot be pushed to this feed)
                    </label>
                </div>
                <small class="text-muted">Global default: @(Model.GlobalOptions.IsReadOnlyMode ? "Enabled" : "Disabled")</small>
            </div>

            <h3>Package Behavior</h3>
            <div class="form-group">
                <div class="checkbox">
                    <label>
                        <input asp-for="UseGlobalOverwrite" data-controls="AllowPackageOverwrites" />
                        Use global default for overwrite policy
                    </label>
                </div>
                <label asp-for="AllowPackageOverwrites">Package overwrite policy</label>
                <select asp-for="AllowPackageOverwrites" class="form-control">
                    <option value="@PackageOverwriteAllowed.False">Disallow (recommended)</option>
                    <option value="@PackageOverwriteAllowed.PrereleaseOnly">Prerelease only</option>
                    <option value="@PackageOverwriteAllowed.True">Allow all</option>
                </select>
                <small class="text-muted">Global default: @(Model.GlobalOptions.AllowPackageOverwrites switch {
                    PackageOverwriteAllowed.False => "Disallow",
                    PackageOverwriteAllowed.PrereleaseOnly => "Prerelease only",
                    _ => "Allow all"
                })</small>
            </div>
            <div class="form-group">
                <div class="checkbox">
                    <label>
                        <input asp-for="UseGlobalDeletion" data-controls="PackageDeletionBehavior" />
                        Use global default for deletion behavior
                    </label>
                </div>
                <label asp-for="PackageDeletionBehavior">Deletion behavior</label>
                <select asp-for="PackageDeletionBehavior" class="form-control">
                    <option value="@PackageDeletionBehavior.Unlist">Unlist (recommended)</option>
                    <option value="@PackageDeletionBehavior.HardDelete">Hard delete</option>
                </select>
                <small class="text-muted">Global default: @(Model.GlobalOptions.PackageDeletionBehavior == PackageDeletionBehavior.HardDelete ? "Hard delete" : "Unlist")</small>
            </div>
            <div class="form-group">
                <div class="checkbox">
                    <label>
                        <input asp-for="UseGlobalMaxSize" data-controls="MaxPackageSizeGiB" />
                        Use global default for max package size
                    </label>
                </div>
                <label asp-for="MaxPackageSizeGiB">Max package size (GiB)</label>
                <input asp-for="MaxPackageSizeGiB" type="number" min="1" class="form-control" style="max-width:160px" placeholder="@Model.GlobalOptions.MaxPackageSizeGiB" />
                <span asp-validation-for="MaxPackageSizeGiB" class="text-danger"></span>
                <small class="text-muted">Global default: @Model.GlobalOptions.MaxPackageSizeGiB GiB</small>
            </div>

            <h3>Retention</h3>
            <div class="form-group">
                <div class="checkbox">
                    <label><input asp-for="UseGlobalRetentionMajor" data-controls="RetentionMaxMajorVersions" /> Use global default</label>
                </div>
                <label asp-for="RetentionMaxMajorVersions">Max major versions to keep</label>
                <input asp-for="RetentionMaxMajorVersions" type="number" min="0" class="form-control" style="max-width:160px" placeholder="@(Model.GlobalOptions.Retention?.MaxMajorVersions?.ToString() ?? "Unlimited")" />
                <span asp-validation-for="RetentionMaxMajorVersions" class="text-danger"></span>
                <small class="text-muted">Global default: @(Model.GlobalOptions.Retention?.MaxMajorVersions?.ToString() ?? "Unlimited")</small>
            </div>
            <div class="form-group">
                <div class="checkbox">
                    <label><input asp-for="UseGlobalRetentionMinor" data-controls="RetentionMaxMinorVersions" /> Use global default</label>
                </div>
                <label asp-for="RetentionMaxMinorVersions">Max minor versions per major</label>
                <input asp-for="RetentionMaxMinorVersions" type="number" min="0" class="form-control" style="max-width:160px" placeholder="@(Model.GlobalOptions.Retention?.MaxMinorVersions?.ToString() ?? "Unlimited")" />
                <span asp-validation-for="RetentionMaxMinorVersions" class="text-danger"></span>
                <small class="text-muted">Global default: @(Model.GlobalOptions.Retention?.MaxMinorVersions?.ToString() ?? "Unlimited")</small>
            </div>
            <div class="form-group">
                <div class="checkbox">
                    <label><input asp-for="UseGlobalRetentionPatch" data-controls="RetentionMaxPatchVersions" /> Use global default</label>
                </div>
                <label asp-for="RetentionMaxPatchVersions">Max patch versions per minor</label>
                <input asp-for="RetentionMaxPatchVersions" type="number" min="0" class="form-control" style="max-width:160px" placeholder="@(Model.GlobalOptions.Retention?.MaxPatchVersions?.ToString() ?? "Unlimited")" />
                <span asp-validation-for="RetentionMaxPatchVersions" class="text-danger"></span>
                <small class="text-muted">Global default: @(Model.GlobalOptions.Retention?.MaxPatchVersions?.ToString() ?? "Unlimited")</small>
            </div>
            <div class="form-group">
                <div class="checkbox">
                    <label><input asp-for="UseGlobalRetentionPrerelease" data-controls="RetentionMaxPrereleaseVersions" /> Use global default</label>
                </div>
                <label asp-for="RetentionMaxPrereleaseVersions">Max prerelease versions per patch</label>
                <input asp-for="RetentionMaxPrereleaseVersions" type="number" min="0" class="form-control" style="max-width:160px" placeholder="@(Model.GlobalOptions.Retention?.MaxPrereleaseVersions?.ToString() ?? "Unlimited")" />
                <span asp-validation-for="RetentionMaxPrereleaseVersions" class="text-danger"></span>
                <small class="text-muted">Global default: @(Model.GlobalOptions.Retention?.MaxPrereleaseVersions?.ToString() ?? "Unlimited")</small>
            </div>

            <h3>Mirrors</h3>
            <p class="text-muted">
                Upstream package sources, queried in order. Version lists from every mirror are merged
                (an earlier mirror wins for the same version), and a package is downloaded from the first
                mirror that has it.
            </p>
            <div id="mirror-list">
                @for (var i = 0; i < Model.Mirrors.Count; i++)
                {
                    MirrorRow(i.ToString(), Model.Mirrors[i]);
                }
            </div>
            <p id="mirror-empty" class="text-muted" hidden="@(Model.Mirrors.Count > 0)">No mirrors: this feed only serves packages pushed to it.</p>
            <button type="button" class="btn btn-default" id="mirror-add">Add mirror</button>

            <template id="mirror-template">
                @{ MirrorRow("__index__", new FeedSettingsModel.MirrorInput { Enabled = true }); }
            </template>

            <div class="form-group" style="margin-top: 16px">
                <div class="checkbox">
                    <label><input asp-for="UseGlobalListingCache" data-controls="UpstreamListingCacheSeconds" /> Use global default for the upstream listing cache</label>
                </div>
                <label asp-for="UpstreamListingCacheSeconds">Upstream listing cache (seconds)</label>
                <input asp-for="UpstreamListingCacheSeconds" type="number" min="0" class="form-control" style="max-width:160px" placeholder="@Model.GlobalOptions.UpstreamListingCacheSeconds" />
                <span asp-validation-for="UpstreamListingCacheSeconds" class="text-danger"></span>
                <small class="text-muted">
                    How long the mirrors' version lists are reused before asking the upstreams again.
                    New upstream versions show up after at most this delay. 0 turns the cache off.
                    Global default: @Model.GlobalOptions.UpstreamListingCacheSeconds
                </small>
            </div>

            <div style="margin-top: 24px">
                <button type="submit" class="btn btn-primary">Save Settings</button>
                <a asp-page="/Admin/Feeds" class="btn btn-default" style="margin-left:8px">Cancel</a>
            </div>
        </div>
    </form>
</div>

<script>
(function () {
    function applyGlobalDefault(checkbox) {
        var targetId = checkbox.dataset.controls;
        if (!targetId) return;
        var target = document.getElementById(targetId);
        if (!target) return;
        target.disabled = checkbox.checked;
        if (checkbox.checked) {
            target.dataset.savedValue = target.value;
            target.value = '';
        } else if ('savedValue' in target.dataset) {
            // Only restore a value stashed by an earlier toggle. On page load the field already
            // holds the feed's stored override, and clearing it would save the feed without it.
            target.value = target.dataset.savedValue;
        }
    }

    document.querySelectorAll('input[data-controls]').forEach(function (cb) {
        applyGlobalDefault(cb);
        cb.addEventListener('change', function () { applyGlobalDefault(cb); });
    });
})();

(function () {
    var list = document.getElementById('mirror-list');
    var template = document.getElementById('mirror-template');
    var empty = document.getElementById('mirror-empty');

    // Rewrites Mirrors[n] and Mirrors_n__ in names, ids and labels so the posted indexes are
    // always 0..count-1 in display order. The saved mirror priority follows that order.
    function renumber() {
        var rows = list.querySelectorAll('.mirror-row');
        rows.forEach(function (row, index) {
            row.querySelector('.mirror-title').textContent = 'Mirror ' + (index + 1);
            row.querySelectorAll('[name], [id], label[for]').forEach(function (el) {
                ['name', 'id', 'for'].forEach(function (attr) {
                    var value = el.getAttribute(attr);
                    if (!value) return;
                    el.setAttribute(attr, value
                        .replace(/^Mirrors\[[^\]]+\]/, 'Mirrors[' + index + ']')
                        .replace(/^Mirrors_(\d+|__index__)__/, 'Mirrors_' + index + '__'));
                });
            });
            row.querySelector('.mirror-up').disabled = index === 0;
            row.querySelector('.mirror-down').disabled = index === rows.length - 1;
        });
        empty.hidden = rows.length > 0;
    }

    document.getElementById('mirror-add').addEventListener('click', function () {
        list.appendChild(template.content.cloneNode(true));
        renumber();
    });

    list.addEventListener('click', function (e) {
        var row = e.target.closest('.mirror-row');
        if (!row) return;

        if (e.target.closest('.mirror-remove')) {
            row.remove();
        } else if (e.target.closest('.mirror-up') && row.previousElementSibling) {
            list.insertBefore(row, row.previousElementSibling);
        } else if (e.target.closest('.mirror-down') && row.nextElementSibling) {
            list.insertBefore(row.nextElementSibling, row);
        } else {
            return;
        }
        renumber();
    });

    renumber();
})();
</script>
